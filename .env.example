# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- LLM ---
# The API key is read by the Anthropic SDK from this variable.
ANTHROPIC_API_KEY=

# Classifier model (Stage 2). Defaults to Haiku because classification is a
# high-volume, cache-heavy task and the prompt optimizes for cost. Bump to
# claude-opus-4-8 for maximum accuracy.
LLM_CLASSIFIER_MODEL=claude-haiku-4-5

# Job-spec parser model (Stage 4, structuring the plain-language job description).
LLM_JOBSPEC_MODEL=claude-haiku-4-5

# Quote-extraction model (Stage 5, PDF -> structured record).
LLM_QUOTE_MODEL=claude-opus-4-8

# --- Ingestion ---
# Comma-separated ZIP codes to scope v0 to. Start with a handful.
TARGET_ZIPS=10029,10035,10037
# Residential unit band (inclusive).
MIN_UNITS=5
MAX_UNITS=50
# Optional NYC Open Data (Socrata) app token — raises rate limits. Not required.
SOCRATA_APP_TOKEN=

# --- Storage ---
DB_PATH=data/cost_engine.sqlite
UPLOAD_DIR=uploads

# --- Dev only ---
# If set to 1 AND no ANTHROPIC_API_KEY is present, the classifier falls back to a
# transparent keyword heuristic so the pipeline/tests can run offline. This is a
# development aid only and must never be relied on for real classification.
ALLOW_HEURISTIC_FALLBACK=0
